# Gateway-specific env vars. Shared infra vars (POSTGRES_URL, AUTH_MODE, JWT_SECRET,
# OIDC_*, ...) live in the repo-root /.env.example — see shared/CONTRACTS.md.
# This file only documents vars the gateway reads that aren't already covered there.

# Where the two Python services the gateway proxies to are reachable:
INGESTION_SERVICE_URL=http://localhost:8000
RETRIEVAL_SERVICE_URL=http://localhost:8001

# Public base URL of this gateway. Required in AUTH_MODE=oidc to build the
# OIDC redirect_uri (<GATEWAY_BASE_URL>/auth/callback) — must match what's
# registered with the IdP.
GATEWAY_BASE_URL=http://localhost:3000

# Angular client origin, used for CORS.
CLIENT_APP_URL=http://localhost:4200

# HTTP port the gateway listens on.
PORT=3000

# Where uploaded files are buffered on local disk before being streamed to
# ingestion-service (deleted immediately after). Defaults to the OS tmp dir.
UPLOAD_TMP_DIR=/tmp/gateway-uploads

# Max accepted upload size, in bytes. Defaults to 512 MiB.
MAX_UPLOAD_SIZE_BYTES=536870912
